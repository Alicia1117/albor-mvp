// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @db.Uuid            
  email     String   @unique
  name      String?
  notes     Note[]
  poems     Poem[]
  favorites Favorite[]
  createdAt DateTime @default(now())

  @@map("users")                             // 對齊資料庫表名 public.users
}

model Note {
  id        String     @id @default(uuid()) @db.Uuid
  title     String
  content   String
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)  // 加 onDelete
  tags      NoteTag[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("notes")
}

model Poem {
  id        String     @id @default(uuid()) @db.Uuid
  title     String
  author    String?
  content   String
  userId    String?    @db.Uuid              // ← 保持 optional
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)  // 加 onDelete
  favorites Favorite[]
  createdAt DateTime   @default(now())

  @@map("poems")
}

model Favorite {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  poemId    String     @db.Uuid

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)  // 加 onDelete
  poem      Poem       @relation(fields: [poemId], references: [id], onDelete: Cascade)  // 加 onDelete
  createdAt DateTime   @default(now())

  @@unique([userId, poemId])  // 防止重複收藏
  @@map("favorites")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  notes     NoteTag[]
  createdAt DateTime   @default(now())

  @@map("tags")
}

model NoteTag {
  noteId String @db.Uuid
  tagId  String @db.Uuid

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)  // 加 onDelete
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)   // 加 onDelete

  @@id([noteId, tagId])
  @@map("note_tags")
}